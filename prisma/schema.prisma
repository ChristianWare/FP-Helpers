// prisma/schema.prisma
// Friendship Park Helpers

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

// =========================
// ENUMS
// =========================

enum CircleRole {
  ADMIN
  HELPER
  RECIPIENT
}

enum CircleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CircleDurationType {
  INDEFINITE
  FIXED
}

// What kind of circle this is.
//   STANDARD   — helpers take turns automatically (the rotation), with the
//                grocery list + prescription features.
//   MEAL_TRAIN — every scheduled day is an open slot. Helpers pick the days
//                that work for them and say what meal they're bringing.
enum CircleType {
  STANDARD
  MEAL_TRAIN
}

enum RotationCadence {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  SWAPPED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  OTHER
}

enum GroceryItemStatus {
  PENDING
  ASSIGNED
  PURCHASED
  UNAVAILABLE
  REMOVED
}

enum PickupReadyStatus {
  CONFIRMED_READY
  NEEDS_CALL
  UNKNOWN
}

enum PickupStatus {
  PENDING
  PICKED_UP
  UNAVAILABLE
  SKIPPED
}

enum SwapStatus {
  OPEN
  CLAIMED
  CANCELLED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum ShiftEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  SWAP_REQUESTED
  SWAP_CLAIMED
  COMPLETED
  FLAGGED
  NOTE_ADDED
  RELEASED // meal train: a helper (or admin) gave a claimed day back
}

// =========================
// AUTH MODELS
// =========================

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String
  password      String?

  passwordSetToken       String?   @unique
  passwordSetTokenExpiry DateTime?

  // System-level flag — only you (super admin) have this set to true
  isSuperAdmin Boolean @default(false)

  // Notification preferences
  emailOptIn       Boolean             @default(true)
  whatsappOptIn    Boolean             @default(false)
  preferredChannel NotificationChannel @default(EMAIL)

  accounts Account[]
  sessions Session[]

  // Circle relations
  memberships      CircleMembership[]
  recipientOf      CareCircle[]       @relation("CircleRecipient")
  invitationsSent  Invitation[]       @relation("InvitationSender")
  joinLinksCreated CircleJoinLink[]   @relation("JoinLinkCreator")

  // Shift relations
  assignedShifts        Shift[]              @relation("ShiftAssignee")
  originalShifts        Shift[]              @relation("ShiftOriginalAssignee")
  groceryItemsAdded     GroceryItem[]        @relation("GroceryItemAddedBy")
  pickupsAdded          PrescriptionPickup[] @relation("PickupAddedBy")
  swapRequestsMade      SwapRequest[]        @relation("SwapRequester")
  swapRequestsClaimed   SwapRequest[]        @relation("SwapClaimer")
  unavailabilityPeriods Unavailability[]
  shiftEventsActed      ShiftEvent[]         @relation("ShiftEventActor")
  notificationsReceived NotificationLog[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// =========================
// CARE CIRCLE — the core tenant
// =========================

model CareCircle {
  id     String       @id @default(cuid())
  name   String // e.g. "Harold's Circle"
  status CircleStatus @default(ACTIVE)

  // Standard rotation circle or meal train — chosen in step 1 of the wizard
  circleType CircleType @default(STANDARD)

  // The recipient (elderly friend)
  recipientId String?
  recipient   User?   @relation("CircleRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  // Contact / location info
  address          String?
  addressCity      String?
  addressState     String?
  addressZip       String?
  accessNotes      String? @db.Text // "spare key under mat", "ring doorbell twice"
  emergencyContact String?
  emergencyPhone   String?
  internalNotes    String? @db.Text // admin-only

  // Schedule settings
  rotationCadence RotationCadence @default(WEEKLY)

  // Days of the week visits happen on (0 = Sunday … 6 = Saturday).
  //   [3]              → Wednesdays
  //   [3, 6]           → Wednesdays and Saturdays
  //   [0,1,2,3,4,5,6]  → every day
  // An EMPTY array means a legacy row that hasn't been backfilled yet —
  // the code falls back to rotationDayOfWeek (see getCircleDays()).
  rotationDaysOfWeek Int[] @default([])

  // DEPRECATED — superseded by rotationDaysOfWeek. Still written (as the
  // first scheduled day) so older rows/scripts keep working. Safe to drop
  // once scripts/backfill-rotation-days.ts has run in every environment.
  rotationDayOfWeek Int @default(6) // 0 = Sunday, 6 = Saturday

  // Fixed reference date for BIWEEKLY circles. "On" weeks are the ones with
  // the same parity as this date's week, so the pattern can't drift no matter
  // which day the generator happens to run.
  scheduleAnchorDate DateTime?

  lookaheadWeeks     Int     @default(8)
  typicalArrivalTime String? // "around 10am" (meal trains: preferred drop-off time)

  // Meal train details — shown to everyone deciding what to cook
  mealHouseholdSize String? // "2 adults, 3 kids"
  mealAllergies     String? @db.Text // allergies + foods to avoid
  mealPreferences   String? @db.Text // favorites, dislikes, anything else

  // Duration — how long this circle is meant to run
  durationType CircleDurationType @default(INDEFINITE)
  startDate    DateTime?
  endDate      DateTime?

  // Whether the completion email has been sent (prevents double-send on cron)
  completionEmailSentAt DateTime?

  // Reminder defaults
  reminderDaysBefore Int[] @default([7, 2, 1])

  // Relations
  memberships         CircleMembership[]
  invitations         Invitation[]
  joinLinks           CircleJoinLink[]
  shifts              Shift[]
  groceryItems        GroceryItem[]
  prescriptions       Prescription[]
  pharmacies          Pharmacy[]
  standingPreferences StandingPreference[]
  unavailability      Unavailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([recipientId])
  @@index([endDate])
  @@index([circleType])
}

// =========================
// CIRCLE MEMBERSHIP
// Roles live here, not on User
// =========================

model CircleMembership {
  id         String     @id @default(cuid())
  userId     String
  circleId   String
  role       CircleRole
  active     Boolean    @default(true)
  inRotation Boolean    @default(true)

  // Stable position in the rotation order (0, 1, 2, ...)
  // Helpers go round-robin in ascending order of this value
  rotationOrder Int @default(0)

  // Tracking
  shiftsCompleted Int       @default(0)
  lastActiveAt    DateTime?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, circleId])
  @@index([circleId])
  @@index([userId])
  @@index([role])
  @@index([rotationOrder])
}

// =========================
// INVITATIONS
// =========================

model Invitation {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  email   String
  role    CircleRole
  token   String           @unique
  status  InvitationStatus @default(PENDING)
  expires DateTime

  invitedById String?
  invitedBy   User?   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedAt DateTime?
  message    String?   @db.Text // optional personal note from inviter

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([email])
  @@index([status])
  @@index([expires])
}

// =========================
// CIRCLE JOIN LINKS
// Shareable links — anyone with the link can join as a helper
// =========================

model CircleJoinLink {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  token  String     @unique
  role   CircleRole @default(HELPER)
  active Boolean    @default(true)

  createdById String?
  createdBy   User?   @relation("JoinLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([token])
  @@index([active])
}

// =========================
// SHIFTS
// =========================

model Shift {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  status        ShiftStatus @default(SCHEDULED)

  // Current assignee
  assignedUserId String?
  assignedUser   User?   @relation("ShiftAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  // Who was originally assigned (preserved through swaps)
  originalAssignedUserId String?
  originalAssignedUser   User?   @relation("ShiftOriginalAssignee", fields: [originalAssignedUserId], references: [id], onDelete: SetNull)

  // Completion data
  completedAt   DateTime?
  amountSpent   Int? // stored in cents
  pharmacySpent Int? // separate line for pharmacy copay
  paymentMethod PaymentMethod?
  cardReturned  Boolean?
  visitNote     String?        @db.Text
  wellnessNote  String?        @db.Text
  flagged       Boolean        @default(false) // set true if wellness concern

  // Meal train — what the helper who claimed this day is bringing.
  // (In a meal train an unclaimed day is simply a shift with no assignee.)
  mealDescription String? // "Chicken enchiladas + rice"
  mealNotes       String? @db.Text // "Contains dairy. Reheat at 350 for 20 min."

  // Relations
  groceryItems        GroceryItem[]
  prescriptionPickups PrescriptionPickup[]
  receiptPhotos       ReceiptPhoto[]
  swapRequests        SwapRequest[]
  events              ShiftEvent[]
  notifications       NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([assignedUserId])
  @@index([scheduledDate])
  @@index([status])
}

// =========================
// GROCERY ITEMS
// Owned by the circle (recipient), assigned to shifts
// =========================

model GroceryItem {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  name     String
  quantity String? // freeform: "2", "a dozen", "the big box"
  notes    String? @db.Text

  addedById String?
  addedBy   User?   @relation("GroceryItemAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  status GroceryItemStatus @default(PENDING)

  // Recurring items auto-appear each shift
  isRecurring     Boolean @default(false)
  recurringEveryN Int     @default(1) // 1 = every shift, 2 = every other, etc.

  // When assigned to a shift
  assignedShiftId String?
  assignedShift   Shift?  @relation(fields: [assignedShiftId], references: [id], onDelete: SetNull)

  // Purchase tracking
  purchasedAt       DateTime?
  purchasedNote     String?
  purchasedPhotoUrl String?
  couldNotFind      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([assignedShiftId])
  @@index([status])
  @@index([isRecurring])
}

// =========================
// STANDING PREFERENCES
// Allergies, brand prefs, "never buy X"
// =========================

model StandingPreference {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  category String // "dietary" | "allergy" | "brand" | "avoid" | "other"
  content  String  @db.Text
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
}

// =========================
// PHARMACIES & PRESCRIPTIONS
// =========================

model Pharmacy {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  phone     String?
  hours     String?
  isDefault Boolean @default(false)

  prescriptions Prescription[]
  pickups       PrescriptionPickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
}

model Prescription {
  id       String     @id @default(cuid())
  circleId String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  medicationName    String
  defaultPharmacyId String?
  defaultPharmacy   Pharmacy? @relation(fields: [defaultPharmacyId], references: [id], onDelete: SetNull)

  typicalRefillDays   Int? // e.g. 30
  lastPickupDate      DateTime?
  notes               String?   @db.Text
  active              Boolean   @default(true)
  needsPickupThisWeek Boolean   @default(false)

  pickups PrescriptionPickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
  @@index([active])
}

model PrescriptionPickup {
  id      String @id @default(cuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  // Link to registered prescription if applicable
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  // Snapshot of what was requested (in case prescription is edited later)
  medicationName       String
  pharmacyId           String?
  pharmacy             Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  pharmacyNameSnapshot String?

  readyStatus   PickupReadyStatus @default(UNKNOWN)
  expectedCopay Int? // cents
  notes         String?           @db.Text

  // Audit
  addedById String?
  addedBy   User?   @relation("PickupAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  // Pickup result
  status          PickupStatus @default(PENDING)
  actualAmount    Int?
  pickedUpAt      DateTime?
  receiptPhotoUrl String?
  pickupNote      String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftId])
  @@index([status])
}

// =========================
// SWAPS & UNAVAILABILITY
// =========================

model SwapRequest {
  id      String @id @default(cuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SwapRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  claimedById String?
  claimedBy   User?   @relation("SwapClaimer", fields: [claimedById], references: [id], onDelete: SetNull)

  status     SwapStatus @default(OPEN)
  reason     String?    @db.Text
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftId])
  @@index([status])
}

model Unavailability {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Null = applies to all circles the user is in
  circleId String?
  circle   CareCircle? @relation(fields: [circleId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  reason    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([circleId])
  @@index([startDate, endDate])
}

// =========================
// RECEIPTS & AUDIT
// =========================

model ReceiptPhoto {
  id      String @id @default(cuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  url        String
  caption    String?
  uploadedAt DateTime @default(now())

  @@index([shiftId])
}

model ShiftEvent {
  id      String         @id @default(cuid())
  shiftId String
  shift   Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type    ShiftEventType

  actorId String?
  actor   User?   @relation("ShiftEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  metadata Json? // e.g. { "fromUserId": "...", "toUserId": "..." } for reassignments

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([createdAt])
}

// =========================
// NOTIFICATIONS
// =========================

model NotificationLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  channel  NotificationChannel
  template String // e.g. "shift_reminder_t2"
  status   NotificationStatus  @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  error       String?   @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([shiftId])
  @@index([status])
  @@index([template])
}
